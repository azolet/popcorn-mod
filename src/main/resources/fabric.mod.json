{
	"schemaVersion": 1,
	"id": "argo_popcorn",
	"version": "${version}",
	"name": "Popcorn",
	"description": "Cook leftover wheat seeds into popcorn in a furnace or a smoker — listen for it popping. Caramelise it with sugar or honey, and serve it in paper buckets you can set down four to a block and take one at a time.",
	"authors": [
		"azolet"
	],
	"contact": {
		"homepage": "https://github.com/azolet/popcorn-mod",
		"sources": "https://github.com/azolet/popcorn-mod",
		"issues": "https://github.com/azolet/popcorn-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/argo_popcorn/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"it.argo.mc.mods.popcorn.PopcornMod"
		],
		"client": [
			"it.argo.mc.mods.popcorn.client.PopcornModClient"
		],
		"fabric-datagen": [
			"it.argo.mc.mods.popcorn.datagen.PopcornDataGenerator"
		]
	},
	"mixins": [
		"argo_popcorn.mixins.json",
		{
			"config": "argo_popcorn.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": ">=0.141.6"
	}
}
